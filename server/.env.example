# Library API
PORT=5000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_management
DB_USER=postgres
DB_PASSWORD=your_local_password

# Direct Registrar Integration
REGISTRAR_MODE=api
REGISTRAR_API_BASE_URL=http://localhost:5001
REGISTRAR_STUDENTS_PATH=/api/registrar/students

# Direct Finance Integration
FINANCE_MODE=mock
FINANCE_API_BASE_URL=http://localhost:FINANCE_PORT
FINANCE_PAYMENTS_PATH=/your-actual-payment-endpoint

# Request Timeout
INTEGRATION_TIMEOUT_MS=8000